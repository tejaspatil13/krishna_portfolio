# ---- Admin auth (required) ----
# Generate with: npm run hash-password -- "a-strong-password"
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# (ADMIN_PASSWORD=plain-text also works, but the hash is preferred.)

# ---- Public URL (used for canonical + Open Graph) ----
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- Supabase (recommended for production; leave empty to use local ./data storage) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=portfolio-media

# Max upload size in MB (keep <= your Supabase plan's per-file limit)
NEXT_PUBLIC_MAX_VIDEO_MB=200
